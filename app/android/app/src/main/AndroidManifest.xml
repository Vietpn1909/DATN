<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera cho obstacle detection -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- Microphone cho STT -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location cho navigation -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Internet cho Goong API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vibration cho cảnh báo gần -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Giữ màn hình bật -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="SafeWalk Hà Nội"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Goong API: REST API key được truyền qua dart-define, không cần meta-data ở đây -->

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Accessibility: cho phép app tương tác với TalkBack -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

</manifest>
